{
	"tasks": {
		"wasmbuild": "deno run -A jsr:@deno/wasmbuild@0.22.0 --inline",
		"wasmbuild:check": "deno run -A jsr:@deno/wasmbuild@0.22.0 --inline --check"
	},
	"compilerOptions": {
		"strict": true,
		"lib": [
			"deno.ns",
			"deno.window",
			"esnext"
		]
	},
	"lint": {
		"include": [
			"src/"
		],
		"exclude": [
			"scripts/"
		],
		"rules": {
			"tags": [
				"recommended"
			]
		}
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 4,
		"semiColons": true,
		"trailingCommas": "never",
		"useBraces": "always",
		"exclude": [
			"LICENSE",
			"README.md"
		]
	},
	"imports": {
		"@deno/wasmbuild": "jsr:@deno/wasmbuild@0.22.0",
		"@scure/base": "npm:@scure/base@2.2.0",
		"@std/assert": "jsr:@std/assert@1.0.19"
	}
}
